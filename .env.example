MONGO_SERVER=mongodb://mongo:27017
MONGO_DB=bimsim
PORT=8090
RDF_SERVER=http://graphdb:7200/repositories/wilson-bimsim
SQL_DB_NAME=pdh
SQL_DB_URL=postgres://postgres:password@postgres:5432/pdh
MONGO_DB_FOR_TOOLS=pdh-tools
MONGO_SERVER_FOR_TOOLS=mongodb://mongo:27017
GRAPHDB_MAPPING_GRAPH=http://ams.validation/graph/mapping-layer
FILE_MAPPING_GRAPH=https://pdh.example/graph/file-mappings
# Optional; set to the predicate namespace used by the RDF mapping data.
# When omitted, the backend matches the required predicate local names.
# RDF_PROPS_NAMESPACE=
KEYCLOAK_ISSUER=https://keycloak.example.org/realms/example-realm
KEYCLOAK_CLIENT_ID=pdh_client
KEYCLOAK_AUDIENCE=account
# Local-only opt-in for loopback requests to tagged RDF read routes.
# Keep false in shared/deployed environments.
PDH_ALLOW_LOCAL_RDF_EVALUATION=false
REDIS_URL=redis://redis:6379
REDIS_ENTITY_TTL_SECONDS=300

# File / Object Adapter (see src/modules/files)
# Root directory the local filesystem backend serves files from. Only files
# within this directory (no path traversal) are exposed via GET /files/*.
FILE_STORAGE_ROOT=/data/pdh-files

# External HTTP API Adapter (see src/modules/external)
# Current weather is provided by Open-Meteo and does not require an API key.
WEATHER_API_BASE_URL=https://api.open-meteo.com
WEATHER_API_TIMEOUT_MS=5000
WEATHER_API_AUTH_TYPE=none
